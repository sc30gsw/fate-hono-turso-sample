{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "exports": {
    "./fate/views": "./src/modules/fate/views.ts"
  },
  "scripts": {
    "build": "dotenvx run -f ../../.env -- bun build src/api.ts --target bun --outdir dist",
    "check": "vp check",
    "dev": "dotenvx run -f ../../.env -- bun --watch src/api.ts",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "start": "dotenvx run -f ../../.env -- bun src/api.ts",
    "test": "vp test"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@hono/valibot-validator": "^0.6.1",
    "@nkzw/fate": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.18",
    "vite-plus": "latest"
  }
}
